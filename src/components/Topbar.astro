---
import { alternateLocaleUrl, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = useTranslations(locale);

// Format current date according to locale
const today = new Date();
const formattedDate = today.toLocaleDateString(locale === 'bm' ? 'ms-MY' : 'en-MY', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<div class="hidden border-b border-brand-maroon-dark bg-brand-maroon py-1.5 text-xs text-white lg:block">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Left: Date -->
    <div class="flex items-center gap-2 text-white/90">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-brand-gold">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span>{formattedDate}</span>
    </div>

    <!-- Right: Language, Font Size, Socials -->
    <div class="flex items-center gap-5">
      <!-- Language Switch -->
      <div class="flex items-center gap-1.5">
        <span class="text-white/80">{t('topbar.languageLabel')}</span>
        {locale === 'en' ? (
          <span class="font-bold text-brand-gold">EN</span>
          <span class="text-white/40">|</span>
          <a href={alternateLocaleUrl(pathname, 'bm')} class="text-white/80 transition-colors hover:text-brand-gold">BM</a>
        ) : (
          <a href={alternateLocaleUrl(pathname, 'en')} class="text-white/80 transition-colors hover:text-brand-gold">EN</a>
          <span class="text-white/40">|</span>
          <span class="font-bold text-brand-gold">BM</span>
        )}
      </div>

      <span class="h-3.5 w-px bg-white/20" aria-hidden="true"></span>

      <!-- Social Icons -->
      <div class="flex items-center gap-3">
        <!-- Facebook -->
        <a
          href="https://www.facebook.com/kysrasmi"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Yayasan Sabah Facebook"
          class="text-white/85 transition-colors hover:text-brand-gold"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95C18.05 21.45 22 17.19 22 12z"/>
          </svg>
        </a>

        <!-- Instagram -->
        <a
          href="https://www.instagram.com/kumpulanyayasansabah/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Yayasan Sabah Instagram"
          class="text-white/85 transition-colors hover:text-brand-gold"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- YouTube -->
        <a
          href="https://www.youtube.com/channel/UCEKB4sp7UvCjcw_w95tUIBw"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Yayasan Sabah YouTube"
          class="text-white/85 transition-colors hover:text-brand-gold"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
