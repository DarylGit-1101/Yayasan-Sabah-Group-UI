---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-brand-border bg-stone-900 text-stone-300">
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      {/* Col 1: Identity */}
      <div class="md:col-span-2">
        <div class="flex items-center gap-3">
          <img src="/images/ys-logo-white.png" alt="Yayasan Sabah Group Logo" class="h-10 w-auto" />
          <div>
            <div class="font-bold text-white tracking-wide">{t('site.name')}</div>
            <div class="text-xs text-stone-400">{t('site.tagline')}</div>
          </div>
        </div>
        <p class="mt-4 text-xs leading-relaxed text-stone-400 max-w-md">
          {locale === 'bm'
            ? 'Menara Tun Mustapha, Ibu Pejabat Yayasan Sabah, Teluk Likas, P.O. Box 11623, 88817 Kota Kinabalu, Sabah, Malaysia.'
            : 'Menara Tun Mustapha, Yayasan Sabah Headquarters, Likas Bay, P.O. Box 11623, 88817 Kota Kinabalu, Sabah, Malaysia.'}
        </p>
      </div>

      {/* Col 2: Services Quick Links */}
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-200">
          {locale === 'bm' ? 'Perkhidmatan' : 'Public Services'}
        </h3>
        <ul class="mt-3 space-y-2 text-xs">
          <li>
            <a href="https://tpns.site/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              {locale === 'bm' ? 'Biasiswa TPNS' : 'TPNS Scholarship'}
            </a>
          </li>
          <li>
            <a href="https://ptps.sabah.gov.my/landing/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              {locale === 'bm' ? 'Portal PTPS' : 'PTPS Portal'}
            </a>
          </li>
          <li>
            <a href={locale === 'bm' ? '/bppp/index.html' : '/bppp/eng/index.html'} class="hover:text-white transition-colors">
              {locale === 'bm' ? 'Bayaran Balik Pinjaman' : 'Loan Repayment (BPPP)'}
            </a>
          </li>
          <li>
            <a href="/facilities.cfm" class="hover:text-white transition-colors">
              {locale === 'bm' ? 'Kemudahan Sukan' : 'Sports Facilities'}
            </a>
          </li>
          <li>
            <a href="/borneo_research_library.cfm" class="hover:text-white transition-colors">
              {locale === 'bm' ? 'Perpustakaan Penyelidikan Borneo' : 'Borneo Research Library'}
            </a>
          </li>
        </ul>
      </div>

      {/* Col 3: Legal & Support */}
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-200">
          {locale === 'bm' ? 'Pautan Penting' : 'Important Links'}
        </h3>
        <ul class="mt-3 space-y-2 text-xs">
          <li>
            <a href="/contact.cfm" class="hover:text-white transition-colors">
              {locale === 'bm' ? 'Hubungi Kami' : 'Contact Us'}
            </a>
          </li>
          <li>
            <a href="/faqs.cfm" class="hover:text-white transition-colors">
              {locale === 'bm' ? 'Soalan Lazim' : 'FAQs'}
            </a>
          </li>
          <li>
            <a href="/tender_notice.cfm" class="hover:text-white transition-colors">
              {locale === 'bm' ? 'Notis Tender' : 'Tenders'}
            </a>
          </li>
          <li>
            <a href="/privacy.cfm" class="hover:text-white transition-colors">
              {locale === 'bm' ? 'Dasar Privasi' : 'Privacy Policy'}
            </a>
          </li>
          <li>
            <a href="/disclaimer.cfm" class="hover:text-white transition-colors">
              {locale === 'bm' ? 'Penafian' : 'Disclaimer'}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-stone-800 pt-6 text-center text-xs text-stone-500">
      <p>&copy; {year} {t('site.name')}. {locale === 'bm' ? 'Hak Cipta Terpelihara.' : 'All rights reserved.'}</p>
    </div>
  </div>
</footer>
