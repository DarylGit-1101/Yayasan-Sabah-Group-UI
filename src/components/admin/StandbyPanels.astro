<!-- PANEL 4: NEWS -->
<section id="panel-news" class="panel-view hidden space-y-4">
  <div class="border-b border-brand-border pb-4">
    <h2 class="text-lg font-bold tracking-tight text-brand-maroon">Press & News Archive</h2>
    <p class="text-xs text-brand-muted">Corporate press releases and event coverage.</p>
  </div>
  <div class="rounded-xl border border-brand-border bg-white p-12 text-center">
    <p class="font-mono text-xs uppercase tracking-wider text-brand-gold">MODULE STANDBY</p>
    <h3 class="mt-2 text-sm font-semibold text-brand-maroon">News & Press Release Editor</h3>
    <p class="mt-1 text-xs text-brand-muted">Connects to the <code class="font-mono text-brand-maroon">news</code> table for bilingual article publishing.</p>
  </div>
</section>

<!-- PANEL 5: FEEDBACK -->
<section id="panel-feedback" class="panel-view hidden space-y-4">
  <div class="border-b border-brand-border pb-4">
    <h2 class="text-lg font-bold tracking-tight text-brand-maroon">Public Feedback Inbox</h2>
    <p class="text-xs text-brand-muted">Direct submissions from the public contact and helpdesk form.</p>
  </div>
  <div class="rounded-xl border border-brand-border bg-white p-12 text-center">
    <p class="font-mono text-xs uppercase tracking-wider text-brand-gold">INBOX STANDBY</p>
    <h3 class="mt-2 text-sm font-semibold text-brand-maroon">Citizen Inquiry Triage</h3>
    <p class="mt-1 text-xs text-brand-muted">Connects to the <code class="font-mono text-brand-maroon">feedback</code> table.</p>
  </div>
</section>

<!-- PANEL 6: ADMINS -->
<section id="panel-admins" class="panel-view hidden space-y-4">
  <div class="border-b border-brand-border pb-4">
    <h2 class="text-lg font-bold tracking-tight text-brand-maroon">Access & Operator Roles</h2>
    <p class="text-xs text-brand-muted">Manage studio accounts and permission tiers.</p>
  </div>
  <div class="rounded-xl border border-brand-border bg-white p-12 text-center">
    <p class="font-mono text-xs uppercase tracking-wider text-brand-gold">SUPERADMIN ONLY</p>
    <h3 class="mt-2 text-sm font-semibold text-brand-maroon">Operator Directory</h3>
    <p class="mt-1 text-xs text-brand-muted">Account provisioning is restricted to superadmin sessions.</p>
  </div>
</section>
