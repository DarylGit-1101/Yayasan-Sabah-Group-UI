<!-- COMMAND PALETTE (⌘K / Ctrl+K) -->
<div id="cmd-palette-modal" class="fixed inset-0 z-50 hidden items-start justify-center bg-black/60 pt-[14vh] p-4 backdrop-blur-xs">
  <div class="w-full max-w-lg overflow-hidden rounded-xl border border-brand-gold/40 bg-brand-maroon-dark text-white shadow-2xl">
    <div class="flex items-center border-b border-white/15 px-4 py-3">
      <svg class="mr-3 size-4 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="cmd-palette-input"
        placeholder="Type a command or search notices & albums…"
        class="w-full bg-transparent text-xs text-white placeholder:text-brand-cream/50 focus:outline-none"
      />
      <kbd class="rounded border border-white/15 bg-brand-maroon px-1.5 py-0.5 font-mono text-[10px] text-brand-gold">ESC</kbd>
    </div>
    <div id="cmd-palette-list" class="max-h-80 overflow-y-auto p-2 divide-y divide-white/10 text-xs">
      <!-- Populated dynamically -->
    </div>
  </div>
</div>
