---
---

<!-- Crisp Utilitarian Topbar -->
<header class="sticky top-0 z-30 flex h-13 items-center justify-between border-b border-brand-border bg-brand-surface/95 px-5 backdrop-blur-md">
  <div class="flex items-center gap-3">
    <button id="open-sidebar-btn" type="button" class="rounded-md p-1 text-brand-maroon hover:bg-brand-cream/60 lg:hidden" aria-label="Open menu">
      <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
    <div class="flex items-center gap-2 text-xs">
      <span class="font-mono text-[11px] uppercase tracking-wider text-brand-gold font-semibold">YSG</span>
      <span class="text-brand-border">/</span>
      <h1 id="page-title" class="font-bold text-brand-maroon">Live Desk</h1>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <button
      type="button"
      data-quick-action="new-album"
      class="hidden sm:inline-flex items-center gap-1.5 rounded-lg border border-brand-border bg-white px-2.5 py-1 text-xs font-semibold text-brand-maroon shadow-2xs transition hover:border-brand-gold hover:bg-brand-cream/30 cursor-pointer"
    >
      <span>+ Album</span>
    </button>
    <button
      type="button"
      data-quick-action="new-notice"
      class="inline-flex items-center gap-1.5 rounded-lg bg-brand-maroon px-3 py-1 text-xs font-semibold text-white shadow-2xs transition hover:bg-brand-maroon-dark cursor-pointer"
    >
      <span>+ Notice</span>
    </button>
  </div>
</header>
