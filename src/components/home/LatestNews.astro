---
import type { Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<section id="news" class="py-16">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex items-center justify-between border-b border-brand-border pb-4">
      <h2 class="text-2xl font-bold tracking-tight text-brand-maroon sm:text-3xl">
        {locale === 'bm' ? 'Berita & Acara Terkini' : 'Latest News & Events'}
      </h2>
      <a href="/media/news/" class="text-xs font-semibold text-brand-maroon hover:underline">
        {locale === 'bm' ? 'Arkib Berita →' : 'News Archive →'}
      </a>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
      {[1, 2, 3].map((num) => (
        <article class="flex flex-col rounded-lg border border-brand-border bg-white p-5 shadow-xs">
          <div class="h-40 rounded bg-stone-100 flex items-center justify-center text-xs text-stone-400">
            Image Placeholder
          </div>
          <span class="mt-4 text-xs text-brand-muted">12 Oct 2026</span>
          <h3 class="mt-1 font-semibold text-brand-ink">
            {locale === 'bm' ? `Tajuk Berita Contoh ${num}` : `Sample News Article Title ${num}`}
          </h3>
        </article>
      ))}
    </div>
  </div>
</section>
