---
import type { ImageMetadata } from 'astro';
import type { Locale } from '../../i18n/ui';
import { Image } from 'astro:assets';
import { supabase, type NewsRow } from '../../db/supabase';
import { resolveAssetImage } from '../../utils/imageHelper';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;

// Eagerly index news cover images from src/assets/news/
const localNewsImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/news/*.{jpeg,jpg,png,webp,avif}',
  { eager: true }
);

// Fetch published news from Supabase (RLS policy enforces status = 2)
let latestArticles: NewsRow[] = [];

try {
  const { data, error } = await supabase
    .from('news')
    .select('*')
    .order('is_featured', { ascending: false })
    .order('published_at', { ascending: false })
    .limit(3);

  if (data && data.length > 0 && !error) {
    latestArticles = data as NewsRow[];
  }
} catch {
  // Offline fallback
}

// Cleanly prepare display articles in frontmatter for zero-spaghetti HTML templates
const displayArticles = latestArticles.map((article) => {
  const title = locale === 'bm' ? (article.title_bm || article.title_en) : (article.title_en || article.title_bm);
  const excerpt = locale === 'bm' ? (article.excerpt_bm || article.excerpt_en) : (article.excerpt_en || article.excerpt_bm);
  const dateStr = article.published_at
    ? new Date(article.published_at).toLocaleDateString(locale === 'bm' ? 'ms-MY' : 'en-MY', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      })
    : '';
  const articleUrl = locale === 'bm' ? `/bm/media/news/${article.slug}/` : `/media/news/${article.slug}/`;
  const image = resolveAssetImage(article.cover_image_url, localNewsImages);

  return {
    ...article,
    title,
    excerpt,
    dateStr,
    articleUrl,
    image,
  };
});
---

<section id="news" class="border-t border-brand-border/40 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="relative mb-8">
      <div class="text-center">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-gold">
          {locale === 'bm' ? 'Cerita & Perkembangan' : 'Stories & Updates'}
        </p>
        <h2 class="mt-1.5 text-2xl font-bold tracking-tight text-brand-maroon sm:text-3xl">
          {locale === 'bm' ? 'Berita & Acara' : 'News & Events'}
        </h2>
      </div>
      <div class="mt-3 flex justify-center sm:absolute sm:right-0 sm:bottom-0 sm:mt-0">
        <a href={locale === 'bm' ? '/bm/media/news/' : '/media/news/'} class="inline-flex items-center gap-2 text-sm font-semibold text-brand-maroon hover:text-brand-gold-hover">
          {locale === 'bm' ? 'Semua berita' : 'All news'} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    {displayArticles.length > 0 ? (
      /* Dynamic news cards from database */
      <div class="mt-7 grid gap-6 md:grid-cols-3">
        {displayArticles.map((article) => (
          <a
            href={article.articleUrl}
            class="group flex flex-col overflow-hidden rounded-2xl border border-brand-border bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:border-brand-gold hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-maroon"
          >
            {article.image.metadata ? (
              <div class="relative aspect-video w-full overflow-hidden bg-white">
                <Image
                  src={article.image.metadata}
                  alt={article.title}
                  width={600}
                  height={338}
                  class="h-full w-full scale-[1.02] object-cover transition-transform duration-500 ease-out will-change-transform group-hover:scale-110"
                  style="backface-visibility: hidden;"
                />
                {/* Gradient fade blending bottom of image seamlessly */}
                <div
                  class="pointer-events-none absolute inset-x-0 -bottom-px h-24 bg-linear-to-t from-white from-10% via-white/90 via-40% to-transparent"
                  aria-hidden="true"
                ></div>
              </div>
            ) : article.image.src ? (
              <div class="relative aspect-video w-full overflow-hidden bg-white">
                <img
                  src={article.image.src}
                  alt={article.title}
                  width="600"
                  height="338"
                  class="h-full w-full scale-[1.02] object-cover transition-transform duration-500 ease-out will-change-transform group-hover:scale-110"
                  style="backface-visibility: hidden;"
                />
                <div
                  class="pointer-events-none absolute inset-x-0 -bottom-px h-24 bg-linear-to-t from-white from-10% via-white/90 via-40% to-transparent"
                  aria-hidden="true"
                ></div>
              </div>
            ) : (
              <div class="aspect-video w-full flex items-center justify-center bg-brand-cream/40 text-brand-maroon/30">
                <svg class="size-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
              </div>
            )}
            <div class="relative z-10 -mt-4 flex flex-1 flex-col justify-between bg-white p-6 pt-0">
              <div>
                <div class="flex items-center justify-between text-xs text-brand-muted">
                  <span class="inline-flex rounded-full bg-brand-cream px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-brand-maroon">
                    {article.category || (locale === 'bm' ? 'Berita' : 'News')}
                  </span>
                  {article.dateStr && <time datetime={article.published_at}>{article.dateStr}</time>}
                </div>
                <h3 class="mt-3 text-lg font-bold tracking-tight text-brand-ink group-hover:text-brand-maroon">
                  {article.title}
                </h3>
                {article.excerpt && (
                  <p class="mt-2 text-sm leading-6 text-brand-muted line-clamp-3">
                    {article.excerpt}
                  </p>
                )}
              </div>
              <div class="mt-5 pt-3 border-t border-brand-border/60">
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-maroon group-hover:text-brand-gold-hover">
                  {locale === 'bm' ? 'Baca selanjutnya' : 'Read more'} <span aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="mt-8 rounded-2xl border border-dashed border-brand-border bg-white/60 p-8 text-center text-sm text-brand-muted">
        {locale === 'bm' ? 'Tiada berita diterbitkan buat masa ini.' : 'No news articles published at this time.'}
      </div>
    )}
  </div>
</section>
