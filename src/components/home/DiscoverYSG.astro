---
import type { Locale } from '../../i18n/ui';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;

const pillars = [
  {
    stat: '1966',
    label: { en: 'Year established', bm: 'Tahun ditubuhkan' },
  },
  {
    stat: '42+',
    label: { en: 'Public services', bm: 'Perkhidmatan awam' },
  },
  {
    stat: '6',
    label: { en: 'Decades of service', bm: 'Dekad berkhidmat' },
  },
  {
    stat: '3',
    label: { en: 'Education institutions', bm: 'Institusi pendidikan' },
  },
] as const;
---

<section id="discover" class="scroll-mt-28 border-t border-brand-border bg-[#f7f3ed] py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">

      {/* Left: copy */}
      <div class="flex flex-col justify-center">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-gold">
          {locale === 'bm' ? 'Tentang kami' : 'About us'}
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-brand-maroon sm:text-3xl">
          {locale === 'bm' ? 'Mengenai Kumpulan Yayasan Sabah' : 'Discover Yayasan Sabah Group'}
        </h2>

        {/* Gold divider */}
        <div class="my-5 h-px w-12 bg-brand-gold" aria-hidden="true"></div>

        <p class="text-sm leading-7 text-brand-muted sm:text-base">
          {locale === 'bm'
            ? 'Ditubuhkan pada 1966 untuk meningkatkan kualiti hidup dan menyediakan peluang pendidikan kepada rakyat Sabah. Selama lebih enam dekad, Kumpulan Yayasan Sabah terus menjadi nadi pembangunan sosioekonomi negeri.'
            : "Established in 1966 to improve the quality of life and expand educational opportunities for the people of Sabah. For over six decades, Yayasan Sabah Group has been central to the state's socioeconomic development."}
        </p>

        <a
          href={locale === 'bm' ? '/bm/about/' : '/about/'}
          class="group mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-maroon transition-colors hover:text-brand-gold-hover"
        >
          {locale === 'bm' ? 'Kenali kami' : 'Learn more'}
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </div>

      {/* Right: stat grid */}
      <div class="grid grid-cols-2 gap-3 content-start">
        {pillars.map(({ stat, label }) => (
          <div class="rounded-xl border border-brand-border bg-white p-5 shadow-sm">
            <p class="text-3xl font-bold tracking-tight text-brand-maroon">{stat}</p>
            <p class="mt-1 text-xs text-brand-muted">{label[locale]}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
