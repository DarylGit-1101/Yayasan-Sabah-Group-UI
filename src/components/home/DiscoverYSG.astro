---
import type { Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<section id="discover" class="bg-stone-50 py-16 border-t border-brand-border">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight text-brand-maroon sm:text-3xl">
        {locale === 'bm' ? 'Mengenai Kumpulan Yayasan Sabah' : 'Discover Yayasan Sabah Group'}
      </h2>
      <p class="mt-3 text-sm text-brand-muted leading-relaxed">
        {locale === 'bm'
          ? 'Ditubuhkan pada 1966 untuk meningkatkan kualiti hidup dan menyediakan peluang pendidikan kepada rakyat Sabah.'
          : 'Established in 1966 to improve the quality of life and expand educational opportunities for the people of Sabah.'}
      </p>
    </div>
  </div>
</section>
