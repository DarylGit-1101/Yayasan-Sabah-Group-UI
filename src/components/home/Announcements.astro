---
import type { Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<section id="announcements" class="scroll-mt-28 border-y border-brand-border bg-[#f7f3ed] py-12 sm:py-14">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex items-center justify-between">
      <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-gold">{locale === 'bm' ? 'Makluman' : 'Stay informed'}</p>
      <h2 class="mt-1 text-xl font-bold text-brand-maroon sm:text-2xl">
        {locale === 'bm' ? 'Pengumuman Penting' : 'Important Announcements'}
      </h2>
      </div>
      <a href={locale === 'bm' ? '/bm/media/' : '/media/'} class="rounded-md px-2 py-2 text-sm font-semibold text-brand-maroon hover:bg-white">
        {locale === 'bm' ? 'Lihat Semua →' : 'View All →'}
      </a>
    </div>
    <a href="https://tpns.site/" target="_blank" rel="noopener noreferrer" class="group mt-6 flex flex-col gap-4 rounded-xl border border-brand-gold/30 bg-white p-5 shadow-sm transition hover:border-brand-gold hover:shadow-md sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <div class="flex items-start gap-4">
        <span class="inline-flex shrink-0 rounded-full bg-brand-maroon px-3 py-1.5 text-[11px] font-bold uppercase tracking-wide text-white">
          {locale === 'bm' ? 'Permohonan dibuka' : 'Applications open'}
        </span>
        <div>
          <h3 class="font-bold text-brand-ink group-hover:text-brand-maroon">
            {locale === 'bm' ? 'Permohonan TPNS 2026 Kini Dibuka' : 'TPNS 2026 Applications Open'}
          </h3>
          <p class="mt-1 text-sm text-brand-muted">
            {locale === 'bm' ? 'Tarikh tutup: 31 Oktober 2026' : 'Closing date: 31 October 2026'}
          </p>
        </div>
      </div>
      <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-maroon">{locale === 'bm' ? 'Mohon sekarang' : 'Apply now'} <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">↗</span></span>
    </a>
  </div>
</section>
