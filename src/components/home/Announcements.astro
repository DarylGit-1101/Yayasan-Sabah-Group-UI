---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { useTranslations, type Locale } from '../../i18n/ui';
import { supabase, type AnnouncementRow } from '../../db/supabase';
import { resolveAssetImage } from '../../utils/imageHelper';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);

// Eagerly index local announcement images from src/assets/announcements/
const localAnnouncementImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/announcements/*.{jpeg,jpg,png,webp,avif}',
  { eager: true }
);

// Fetch active announcements from Supabase
let rawAnnouncements: AnnouncementRow[] = [];

try {
  const { data, error } = await supabase
    .from('announcements')
    .select('*')
    .order('is_pinned', { ascending: false })
    .order('published_at', { ascending: false });

  if (data && data.length > 0 && !error) {
    rawAnnouncements = data as AnnouncementRow[];
  }
} catch {
  // Offline fallback
}

// Prepare display items in frontmatter so the HTML template stays clean
const displayItems = rawAnnouncements.map((item) => {
  const title = locale === 'bm' ? (item.title_bm || item.title_en) : (item.title_en || item.title_bm);
  const content = locale === 'bm' ? (item.content_bm || item.content_en) : (item.content_en || item.content_bm);
  const link = item.attachment_url || item.banner_url || '#';
  const isExternal = link.startsWith('http://') || link.startsWith('https://');
  const image = resolveAssetImage(item.banner_url, localAnnouncementImages);

  return {
    ...item,
    title,
    content,
    link,
    isExternal,
    image,
  };
});

const showArrows = displayItems.length > 1;
---

<section id="announcements" class="border-y border-brand-border/40 py-12 sm:py-16">
  <div class="w-full px-6 lg:px-8">

    {/* Section header */}
    <div class="relative mb-6">
      <div class="text-center">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-gold">
          {locale === 'bm' ? 'Makluman' : 'Stay informed'}
        </p>
        <h2 class="mt-1.5 text-2xl font-bold tracking-tight text-brand-maroon sm:text-3xl">
          {locale === 'bm' ? 'Pengumuman Penting' : 'Important Announcements'}
        </h2>
      </div>

      <div class="mt-4 flex items-center justify-center gap-2 sm:absolute sm:right-0 sm:bottom-0 sm:mt-0">
        {showArrows && (
          <>
            <button
              type="button"
              data-carousel-prev
              aria-label={t('action.previous')}
              class="flex size-9 items-center justify-center rounded-full border border-brand-border bg-white text-brand-ink shadow-sm transition-all hover:border-brand-gold hover:text-brand-maroon active:scale-95 disabled:pointer-events-none disabled:opacity-40"
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 19l-7-7 7-7"/>
              </svg>
            </button>
            <button
              type="button"
              data-carousel-next
              aria-label={t('action.next')}
              class="flex size-9 items-center justify-center rounded-full border border-brand-border bg-white text-brand-ink shadow-sm transition-all hover:border-brand-gold hover:text-brand-maroon active:scale-95 disabled:pointer-events-none disabled:opacity-40"
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </>
        )}
        <a
          href={locale === 'bm' ? '/bm/media/' : '/media/'}
          class="ml-1 inline-flex items-center gap-1 text-sm font-semibold text-brand-maroon transition-colors hover:text-brand-gold-hover"
        >
          {t('action.viewAll')}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    {displayItems.length > 0 ? (
      <>
        {/* Carousel track */}
        <div
          data-carousel-track
          class="mt-4 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pt-2.5 pb-4 px-1"
          style="scrollbar-width: none; -ms-overflow-style: none;"
          role="list"
          aria-label={locale === 'bm' ? `${displayItems.length} pengumuman` : `${displayItems.length} announcements`}
        >
          {displayItems.map((item) => (
            <div class="shrink-0 snap-start" role="listitem">
              <article class="group relative flex h-96 w-88 max-w-[82vw] cursor-pointer flex-col justify-between overflow-hidden rounded-2xl border border-brand-border bg-white shadow-xs transition-all duration-200 hover:border-brand-gold hover:shadow-lg">
                <div class="h-40 shrink-0 overflow-hidden bg-linear-to-br from-brand-cream to-brand-sand">
                  {item.image.metadata ? (
                    <Image
                      src={item.image.metadata}
                      alt={item.title}
                      width={352}
                      height={160}
                      loading="lazy"
                      class="block h-full w-full object-cover"
                    />
                  ) : item.image.src ? (
                    <img
                      src={item.image.src}
                      alt={item.title}
                      width="352"
                      height="160"
                      loading="lazy"
                      class="block h-full w-full object-cover"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center text-xs font-semibold uppercase tracking-wider text-brand-maroon/50">
                      Yayasan Sabah Group
                    </div>
                  )}
                </div>
                <div class="flex flex-1 flex-col justify-between p-5">
                  <div>
                    <h3 class="line-clamp-2 text-base font-bold leading-snug text-slate-900 transition-colors duration-200 group-hover:text-brand-maroon">
                      {item.title}
                    </h3>
                    {item.content && (
                      <p class="mt-2 line-clamp-3 text-[13.5px] leading-relaxed text-slate-500">
                        {item.content}
                      </p>
                    )}
                  </div>
                  <a
                    href={item.link}
                    target={item.isExternal ? '_blank' : undefined}
                    rel={item.isExternal ? 'noopener noreferrer' : undefined}
                    class="mt-4 inline-block self-start rounded-lg bg-brand-maroon px-3.5 py-2 text-[13px] font-semibold text-white no-underline transition-colors duration-200 after:absolute after:inset-0 after:z-[5] hover:bg-brand-gold focus-visible:bg-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-maroon"
                  >
                    {locale === 'bm' ? 'Maklumat lanjut' : 'Find out more'}
                  </a>
                </div>
              </article>
            </div>
          ))}
        </div>

        {/* Dot indicators */}
        {showArrows && (
          <div class="mt-4 flex justify-center gap-1.5" data-carousel-dots aria-hidden="true">
            {displayItems.map((_, i) => (
              <button
                type="button"
                data-dot-index={i}
                aria-label={`Slide ${i + 1}`}
                class:list={[
                  'size-2 rounded-full transition-all duration-300',
                  i === 0 ? 'w-5 bg-brand-maroon' : 'bg-brand-border hover:bg-brand-gold/60',
                ]}
              />
            ))}
          </div>
        )}
      </>
    ) : (
      <div class="mt-8 rounded-2xl border border-dashed border-brand-border bg-white/60 p-8 text-center text-sm text-brand-muted">
        {locale === 'bm' ? 'Tiada pengumuman aktif buat masa ini.' : 'No active announcements at this time.'}
      </div>
    )}

    {/* Mobile "View All" link */}
    <a
      href={locale === 'bm' ? '/bm/media/' : '/media/'}
      class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-maroon transition-colors hover:text-brand-gold-hover sm:hidden"
    >
      {locale === 'bm' ? 'Lihat Semua' : 'View All'}
      <span aria-hidden="true">→</span>
    </a>

  </div>
</section>

<style>
  [data-carousel-track]::-webkit-scrollbar {
    display: none;
  }
</style>

{/* Carousel arrow + dot navigation script */}
<script>
  function initCarousels() {
    const sections = document.querySelectorAll<HTMLElement>('#announcements');
    sections.forEach((section) => {
      const track = section.querySelector<HTMLElement>('[data-carousel-track]');
      const prevBtn = section.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const nextBtn = section.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const dotsContainer = section.querySelector<HTMLElement>('[data-carousel-dots]');

      if (!track) return;

      const cards = track.querySelectorAll<HTMLElement>(':scope > *');
      if (cards.length < 2) return;

      function getCardWidth(): number {
        const card = cards[0];
        const gap = parseFloat(getComputedStyle(track!).gap) || 20;
        return card.offsetWidth + gap;
      }

      function getActiveIndex(): number {
        const scrollLeft = track!.scrollLeft;
        const cardWidth = getCardWidth();
        return Math.round(scrollLeft / cardWidth);
      }

      function updateButtons() {
        const idx = getActiveIndex();
        const maxIdx = cards.length - 1;
        if (prevBtn) prevBtn.disabled = idx <= 0;
        if (nextBtn) nextBtn.disabled = idx >= maxIdx;
      }

      function updateDots() {
        if (!dotsContainer) return;
        const idx = getActiveIndex();
        const dots = dotsContainer.querySelectorAll<HTMLElement>('button');
        dots.forEach((dot, i) => {
          const isActive = i === idx;
          dot.classList.toggle('bg-brand-maroon', isActive);
          dot.classList.toggle('w-5', isActive);
          dot.classList.toggle('bg-brand-border', !isActive);
          dot.classList.toggle('w-2', !isActive);
        });
      }

      function scrollToIndex(idx: number) {
        const cardWidth = getCardWidth();
        track!.scrollTo({ left: idx * cardWidth, behavior: 'smooth' });
      }

      prevBtn?.addEventListener('click', () => {
        const idx = getActiveIndex();
        if (idx > 0) scrollToIndex(idx - 1);
      });

      nextBtn?.addEventListener('click', () => {
        const idx = getActiveIndex();
        if (idx < cards.length - 1) scrollToIndex(idx + 1);
      });

      dotsContainer?.querySelectorAll<HTMLButtonElement>('button').forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = Number(dot.dataset.dotIndex);
          scrollToIndex(idx);
        });
      });

      let scrollTimer: ReturnType<typeof setTimeout>;
      track.addEventListener('scroll', () => {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          updateButtons();
          updateDots();
        }, 60);
      }, { passive: true });

      // Initial state
      updateButtons();
      updateDots();
    });
  }

  // Run on initial load and after Astro client-side transitions
  initCarousels();
  document.addEventListener('astro:after-swap', initCarousels);
</script>
