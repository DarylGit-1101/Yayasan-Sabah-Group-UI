---
import type { Locale } from '../../i18n/ui';
import QuickAccessCard from './QuickAccessCard.astro';
import { supabase, type QuickLinkRow } from '../../db/supabase';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

// Fetch directly from quick_links table in Supabase
let items: QuickLinkRow[] = [];

try {
  const { data, error } = await supabase
    .from('quick_links')
    .select('*')
    .order('sort_order', { ascending: true });

  if (data && !error) {
    items = data as QuickLinkRow[];
  }
} catch {
  // Offline fallback
}

const count = items.length;
---

<section id="services" class="scroll-mt-28 border-t border-brand-border/30 bg-brand-surface/10 backdrop-blur-md py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">

    {/* Section header */}
    <div class="mb-8 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-gold">
          {locale === 'bm' ? 'Untuk anda' : 'Here to help'}
        </p>
        <h2 class="mt-1.5 text-2xl font-bold tracking-tight text-brand-maroon sm:text-3xl">
          {locale === 'bm' ? 'Akses Pantas' : 'Quick Access'}
        </h2>
        <p class="mt-2 max-w-xl text-sm text-stone-700 font-medium">
          {locale === 'bm'
            ? 'Akses pantas kepada portal, borang dan perkhidmatan Kumpulan Yayasan Sabah.'
            : 'Quick access to Yayasan Sabah Group portals, forms, and services.'}
        </p>
      </div>
      <a
        href={locale === 'bm' ? '/bm/media/faq/' : '/media/faq/'}
        class="mt-3 inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-brand-maroon transition-colors hover:text-brand-gold-hover sm:mt-0"
      >
        {locale === 'bm' ? 'Perlukan bantuan?' : 'Need help?'}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {/* Accessible card list */}
    {items.length > 0 ? (
      <ul
        class="grid auto-rows-fr grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
        role="list"
        aria-label={locale === 'bm' ? `${count} perkhidmatan pantas` : `${count} quick access services`}
      >
        {items.map((item) => (
          <li class="flex h-full">
            <QuickAccessCard item={item} locale={locale} />
          </li>
        ))}
      </ul>
    ) : (
      <div class="rounded-xl border border-dashed border-brand-border p-8 text-center text-sm text-brand-muted">
        {locale === 'bm'
          ? 'Tiada pautan pantas dijumpai. Tambah pautan dalam jadual quick_links Supabase anda.'
          : 'No quick links found. Add links in your Supabase quick_links table.'}
      </div>
    )}

  </div>
</section>
