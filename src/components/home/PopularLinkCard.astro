---
import type { Locale } from '../../i18n/ui';
import type { QuickAccessItem } from '../../data/quick-access';

interface Props {
  item: QuickAccessItem;
  locale: Locale;
}

const { item, locale } = Astro.props;
const isExternal = item.external === true;
const isClosed   = item.available === false;
---

<a
  href={item.href[locale]}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="group relative flex h-full min-h-32 w-full flex-col justify-between overflow-hidden rounded-xl border border-brand-border bg-white p-5 shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-brand-gold/50 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-maroon"
>


  {/* Card title — always visible, full colour */}
  <p class="my-3 text-sm font-semibold leading-snug text-brand-maroon transition-colors duration-200 group-hover:text-brand-maroon-dark sm:text-(length:--text-base)">
    {item.title[locale]}
  </p>

  {/* Badges */}
  <div class="flex flex-wrap gap-1.5 min-h-5">
    {isClosed && (
      <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-[11px] font-semibold leading-none text-red-700 ring-1 ring-inset ring-red-600/20">
        {locale === 'bm' ? 'Ditutup' : 'Closed'}
      </span>
    )}
    {isExternal && !isClosed && (
      <span class="inline-flex items-center gap-1 rounded-full bg-brand-cream px-2 py-0.5 text-[11px] font-semibold leading-none text-brand-maroon ring-1 ring-inset ring-brand-gold/30">
        <svg class="size-2.5 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 3H3v10h10v-3M10 3h3v3M13 3 7 9"/>
        </svg>
        {locale === 'bm' ? 'Laman Luaran' : 'External'}
      </span>
    )}
  </div>

  {/* Arrow circle — anchored to bottom-right */}
  <div class="mt-4 flex items-center justify-end">
    <span class="flex size-7 items-center justify-center rounded-full bg-brand-cream text-brand-gold ring-1 ring-inset ring-brand-gold/30 transition-all duration-200 group-hover:bg-brand-gold group-hover:text-white group-hover:ring-0">
      <svg class="size-3.5 transition-transform duration-200 group-hover:translate-x-px" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4"/>
      </svg>
    </span>
  </div>

  {/* Bottom accent bar — slides in from left on hover */}
  <div
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-linear-to-r from-brand-gold to-brand-gold/30 transition-transform duration-300 ease-out group-hover:scale-x-100"
  ></div>
</a>
