---
import type { Locale } from '../../i18n/ui';
import PopularLinkCard from './PopularLinkCard.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<section id="services" class="py-16">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="border-b border-brand-border pb-4">
      <h2 class="text-2xl font-bold tracking-tight text-brand-maroon sm:text-3xl">
        {locale === 'bm' ? 'Perkhidmatan Utama' : 'Popular Services'}
      </h2>
      <p class="mt-2 text-sm text-brand-muted">
        {locale === 'bm' ? 'Akses terus kepada bantuan pendidikan, bayaran balik pinjaman, dan kemudahan awam.' : 'Direct access to education aid, loan repayment, and public facilities.'}
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {/* Skeleton cards to demonstrate layout */}
      
    </div>
  </div>
</section>
