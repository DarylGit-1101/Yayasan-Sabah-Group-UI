---
import type { Locale } from '../../i18n/ui';
import { QUICK_ACCESS_ITEMS } from '../../data/quick-access';
import PopularLinkCard from './PopularLinkCard.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const count = QUICK_ACCESS_ITEMS.length;
---

<section id="services" class="scroll-mt-28 border-t border-brand-border bg-base py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">

    {/* Section header */}
    <div class="mb-8 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-gold">
          {locale === 'bm' ? 'Untuk anda' : 'Here to help'}
        </p>
        <h2 class="mt-1.5 text-2xl font-bold tracking-tight text-brand-maroon sm:text-3xl">
          {locale === 'bm' ? 'Akses Pantas' : 'Quick Access'}
        </h2>
        <p class="mt-2 max-w-xl text-sm text-brand-muted">
          {locale === 'bm'
            ? 'Akses pantas kepada portal, borang dan perkhidmatan Kumpulan Yayasan Sabah.'
            : 'Quick access to Yayasan Sabah Group portals, forms, and services.'}
        </p>
      </div>
      <a
        href={locale === 'bm' ? '/bm/media/faq/' : '/media/faq/'}
        class="mt-3 inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-brand-maroon transition-colors hover:text-brand-gold-hover sm:mt-0"
      >
        {locale === 'bm' ? 'Perlukan bantuan?' : 'Need help?'}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {/* Accessible card list */}
    <ul
      class="grid auto-rows-fr grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
      role="list"
      aria-label={locale === 'bm' ? `${count} perkhidmatan pantas` : `${count} quick access services`}
    >
      {QUICK_ACCESS_ITEMS.map((item) => (
        <li class="flex h-full">
          <PopularLinkCard item={item} locale={locale} />
        </li>
      ))}
    </ul>

  </div>
</section>
