---
import type { Locale } from '../../i18n/ui';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
---

<section id="hero" class="relative isolate overflow-hidden bg-brand-maroon text-white" aria-labelledby="hero-heading">
  {/* Ambient background lighting */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -right-28 -top-52 h-136 w-136 rounded-full bg-brand-gold/20 blur-[100px]"></div>
    <div class="absolute -bottom-72 left-[35%] h-140 w-180 rounded-full bg-brand-maroon-light/70 blur-[110px]"></div>
    <div class="absolute inset-0 opacity-[0.08]" style="background-image: radial-gradient(rgba(255,255,255,.7) .7px, transparent .7px); background-size: 24px 24px;"></div>
  </div>

  {/* Full-width Video Layer — Desktop ONLY (Strictly 0 bytes on mobile) */}
  <div class="pointer-events-none absolute inset-0 hidden h-full w-full overflow-hidden lg:block" aria-hidden="true">
    <video
      autoplay
      loop
      muted
      playsinline
      class="h-full w-full object-cover object-center"
    >
      <source src="/videos/YSG-intro-720p.mp4" type="video/mp4" media="(min-width: 1024px)" />
    </video>

    {/* Balanced uniform overlay: 20% Maroon + subtle uniform darkening for equal left-right contrast */}
    <div class="absolute inset-0 bg-brand-maroon/30"></div>
    <div class="absolute inset-0 bg-black/35"></div>

    {/* Top and bottom edge blend into section borders (No left-right gradient) */}
    <div class="absolute inset-x-0 top-0 h-16 bg-linear-to-b from-brand-maroon/60 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-20 bg-linear-to-t from-brand-maroon/80 to-transparent"></div>
  </div>

  {/* Hero Content Grid */}
  <div class="relative z-10 grid w-full items-center gap-12 px-6 py-20 sm:py-24 lg:grid-cols-[minmax(0,1.2fr)_minmax(16rem,.8fr)] lg:px-8 lg:py-28">
    <div>
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-white [text-shadow:0_2px_12px_rgb(0_0_0/60%)]">
        <span class="h-px w-7 bg-white"></span>{locale === 'bm' ? 'Portal Rasmi' : 'Official Portal'}
      </span>
      <h1 id="hero-heading" class="mt-5 text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl [text-shadow:0_2px_12px_rgb(0_0_0/60%)]">
        {locale === 'bm' ? <>Menerajui pembangunan <span class="text-brand-gold">rakyat Sabah.</span></> : <>Advancing education and <span class="text-brand-gold">opportunity in Sabah.</span></>}
      </h1>
      <p class="mt-6 text-base leading-7 sm:text-lg sm:leading-8 text-white/95 [text-shadow:0_1px_8px_rgb(0_0_0/50%)]">
        {locale === 'bm'
          ? 'Akses kepada biasiswa, pinjaman, pendidikan awal kanak-kanak, kemudahan dan sumber awam Kumpulan Yayasan Sabah.'
          : 'Find scholarships, education loans, early learning, public facilities, and services from Yayasan Sabah Group.'}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#services" class="group inline-flex min-h-12 items-center gap-3 rounded-lg bg-brand-gold px-5 py-3 text-sm font-bold text-brand-maroon-dark shadow-xl shadow-black/30 transition hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
          {locale === 'bm' ? 'Akses Pantas' : 'Quick Start'}
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
        <a href="#announcements" class="inline-flex min-h-12 items-center rounded-lg border border-white/35 bg-black/20 px-5 py-3 text-sm font-semibold text-white backdrop-blur-xs transition hover:border-white/60 hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
          {locale === 'bm' ? 'Pengumuman' : 'Announcements'}
        </a>
      </div>
    </div>

    {/* Right card sits in front of the video with frosted glass backdrop */}
    <aside class="hidden lg:block" aria-label={locale === 'bm' ? 'Maklumat Kumpulan Yayasan Sabah' : 'About Yayasan Sabah Group'}>
      <div class="rounded-2xl border border-white/20 bg-brand-maroon/50 p-7 backdrop-blur-md shadow-2xl shadow-black/40">
        <span class="text-xs font-bold uppercase tracking-[0.18em] text-brand-gold">{locale === 'bm' ? 'Bersama Sabah sejak' : 'Serving Sabah since'}</span>
        <p class="mt-3 text-6xl font-semibold tracking-tight">1966</p>
        <p class="mt-4 max-w-xs text-sm leading-6 text-white/90">
          {locale === 'bm' ? 'Memperluas peluang pendidikan dan menyokong pembangunan sosial ekonomi negeri.' : 'Expanding access to education and supporting the state’s socioeconomic development.'}
        </p>
        <a href={locale === 'bm' ? '/bm/about/' : '/about/'} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-white transition hover:text-brand-gold">
          {locale === 'bm' ? 'Kenali kami' : 'Get to know us'} <span aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
  </div>
</section>
