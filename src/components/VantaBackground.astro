---
// Standalone 3D Animated Background Component powered by Vanta.js (WAVES)
// Loads asynchronously during browser idle time to avoid blocking initial page render.
---

<!-- Fixed background canvas: stays pinned behind all content without blocking clicks -->
<div id="vanta-waves-bg" class="fixed inset-0 -z-20 pointer-events-none" aria-hidden="true"></div>

<script is:inline>
  (function () {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion || window.innerWidth < 768) return;

    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        const s = document.createElement('script');
        s.src = src;
        s.async = true;
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    function initVanta() {
      loadScript('https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js')
        .then(function () {
          return loadScript('https://cdn.jsdelivr.net/npm/vanta@0.5.24/dist/vanta.waves.min.js');
        })
        .then(function () {
          if (window.VANTA && window.VANTA.WAVES) {
            window.VANTA.WAVES({
              el: '#vanta-waves-bg',
              mouseControls: true,
              touchControls: false,
              gyroControls: false,
              minHeight: 200.0,
              minWidth: 200.0,
              scale: 1.0,
              scaleMobile: 1.0,
              color: 0xada297,   // Warm cream color
              shininess: 20.0,   // Soft light reflections
              waveHeight: 16.0,  // Smooth wave amplitude
              waveSpeed: 0.65,   // Gentle, elegant pace
              zoom: 0.85,
            });
          }
        })
        .catch(function () {
          // Silently ignore if CDN is unreachable offline
        });
    }

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(initVanta, { timeout: 2500 });
    } else {
      window.addEventListener('load', function () {
        setTimeout(initVanta, 200);
      });
    }
  })();
</script>
