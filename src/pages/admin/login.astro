---
import { Image } from 'astro:assets';
import AdminLayout from '../../layouts/AdminLayout.astro';
import logoWhiteImg from '../../assets/ys-logo-white.png';
---

<AdminLayout title="Staff Sign-In">
  <main class="relative flex min-h-screen flex-col justify-between bg-brand-maroon-dark text-white selection:bg-brand-gold selection:text-brand-maroon-dark overflow-hidden">
    <!-- Architectural Hairline Grid Background -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.05]"
      style="background-image: linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px); background-size: 48px 48px;"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-brand-gold/50 to-transparent"
      aria-hidden="true"
    ></div>

    <!-- Top Studio Bar -->
    <header class="relative z-10 flex items-center justify-between border-b border-white/10 px-6 py-4 sm:px-10">
      <a href="/" class="group flex items-center gap-3">
        <Image src={logoWhiteImg} alt="Yayasan Sabah Group" class="h-8 w-auto opacity-95 transition group-hover:opacity-100" loading="eager" />
        <div class="flex items-center gap-2 border-l border-white/20 pl-3">
          <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-cream">YSG</span>
          <span class="rounded bg-brand-gold/25 border border-brand-gold/40 px-1.5 py-0.5 font-mono text-[10px] font-medium text-brand-gold">STUDIO</span>
        </div>
      </a>

      <a
        href="/"
        class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 font-mono text-[11px] text-brand-cream/80 transition hover:border-brand-gold/60 hover:bg-white/10 hover:text-white"
      >
        <span>Return to public portal</span>
        <span aria-hidden="true">→</span>
      </a>
    </header>

    <!-- Center Authentication Module -->
    <section class="relative z-10 mx-auto flex w-full max-w-[400px] flex-col justify-center px-6 py-12">
      <div class="mb-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-gold/30 bg-brand-maroon/70 px-2.5 py-1 mb-4">
          <span class="size-1.5 rounded-full bg-brand-gold"></span>
          <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-brand-cream">Internal Session</span>
        </div>
        <h1 class="text-2xl font-semibold tracking-tight text-white">Sign in to workspace</h1>
        <p class="mt-1.5 text-xs leading-relaxed text-brand-cream/75">
          Enter your credentials to manage homepage highlights, public notices, and media records.
        </p>
      </div>

      <form
        id="login-form"
        method="post"
        class="rounded-xl border border-white/15 bg-brand-maroon/90 p-6 shadow-2xl backdrop-blur-md"
        novalidate
      >
        <div>
          <label for="username" class="block font-mono text-[11px] uppercase tracking-wider text-brand-cream/80">
            Username
          </label>
          <input
            id="username"
            name="username"
            type="text"
            autocomplete="username"
            required
            class="mt-2 block w-full rounded-lg border border-white/15 bg-brand-maroon-dark/80 px-3.5 py-2.5 text-sm text-white placeholder:text-brand-cream/35 focus:border-brand-gold focus:outline-none focus:ring-1 focus:ring-brand-gold transition"
            placeholder="admin_username"
          />
        </div>

        <div class="mt-4">
          <label for="password" class="block font-mono text-[11px] uppercase tracking-wider text-brand-cream/80">
            Password
          </label>
          <div class="relative mt-2">
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              class="block w-full rounded-lg border border-white/15 bg-brand-maroon-dark/80 py-2.5 pl-3.5 pr-11 text-sm text-white placeholder:text-brand-cream/35 focus:border-brand-gold focus:outline-none focus:ring-1 focus:ring-brand-gold transition"
              placeholder="••••••••"
            />
            <button
              id="toggle-password"
              type="button"
              aria-label="Show password"
              aria-pressed="false"
              class="absolute inset-y-0 right-0 flex w-10 items-center justify-center rounded-r-lg text-brand-cream/60 transition-colors hover:text-white focus-visible:outline-none"
            >
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
        </div>

        <p
          id="login-error"
          role="alert"
          aria-live="polite"
          class="mt-4 hidden rounded-lg border border-rose-400/40 bg-rose-950/60 px-3 py-2 text-xs text-rose-200"
        ></p>

        <button
          id="login-submit"
          type="submit"
          class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-gold px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-sm transition hover:bg-brand-gold-hover cursor-pointer disabled:opacity-60"
        >
          <span id="login-label">Continue</span>
          <svg
            id="login-spinner"
            class="hidden size-3.5 animate-spin"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v8H4Z"></path>
          </svg>
        </button>
      </form>
    </section>

    <!-- Bottom Status Bar -->
    <footer class="relative z-10 flex items-center justify-between border-t border-white/10 px-6 py-3.5 font-mono text-[11px] text-brand-cream/60 sm:px-10">
      <span>Yayasan Sabah Group</span>
      <span>Authorised Personnel Only</span>
    </footer>
  </main>
</AdminLayout>

<script>
  import { supabase } from '../../db/supabase';

  const STORAGE_KEY = 'ysg_admin_session';

  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const username = document.getElementById('username') as HTMLInputElement | null;
  const password = document.getElementById('password') as HTMLInputElement | null;
  const toggle = document.getElementById('toggle-password') as HTMLButtonElement | null;
  const errorBox = document.getElementById('login-error');
  const submit = document.getElementById('login-submit') as HTMLButtonElement | null;
  const label = document.getElementById('login-label');
  const spinner = document.getElementById('login-spinner');

  const root = window.location.pathname.replace(/\/login\/?$/, '');
  const next = `${root}/dashboard/`;

  function showError(message: string) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
  }

  function clearError() {
    if (!errorBox) return;
    errorBox.textContent = '';
    errorBox.classList.add('hidden');
  }

  function setLoading(loading: boolean) {
    if (submit) submit.disabled = loading;
    if (label) label.textContent = loading ? 'Verifying…' : 'Continue';
    spinner?.classList.toggle('hidden', !loading);
  }

  try {
    const existing = sessionStorage.getItem(STORAGE_KEY);
    if (existing) {
      const parsed = JSON.parse(existing);
      if (parsed && parsed.admin_id && parsed.admin_username) {
        window.location.replace(next);
      }
    }
  } catch {
    // ignore storage errors
  }

  toggle?.addEventListener('click', () => {
    if (!password) return;
    const reveal = password.type === 'password';
    password.type = reveal ? 'text' : 'password';
    toggle.setAttribute('aria-pressed', String(reveal));
    toggle.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password');
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearError();

    const userValue = username?.value.trim() ?? '';
    const passValue = password?.value ?? '';

    if (!userValue || !passValue) {
      showError('Please enter both your username and password.');
      return;
    }

    setLoading(true);

    try {
      const { data, error } = await supabase.rpc('verify_admin_login', {
        p_username: userValue,
        p_password: passValue,
      });

      if (error) {
        showError('Unable to reach authentication service. Please try again.');
        setLoading(false);
        return;
      }

      const row = Array.isArray(data) ? data[0] : data;

      if (!row || !row.admin_id) {
        showError('Invalid username or password, or account is inactive.');
        setLoading(false);
        return;
      }

      sessionStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          admin_id: row.admin_id,
          admin_username: row.admin_username,
          role: row.role,
          admin_status: row.admin_status,
          last_login: row.last_login,
        }),
      );

      window.location.href = next;
    } catch {
      showError('An unexpected error occurred. Please try again.');
      setLoading(false);
    }
  });
</script>
