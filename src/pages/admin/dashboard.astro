---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/admin/AdminSidebar.astro';
import AdminTopbar from '../../components/admin/AdminTopbar.astro';
import OverviewPanel from '../../components/admin/OverviewPanel.astro';
import HighlightsPanel from '../../components/admin/HighlightsPanel.astro';
import AnnouncementsPanel from '../../components/admin/AnnouncementsPanel.astro';
import StandbyPanels from '../../components/admin/StandbyPanels.astro';
import CommandPaletteModal from '../../components/admin/CommandPaletteModal.astro';
import 'filepond/dist/filepond.min.css';
import 'filepond-plugin-image-preview/dist/filepond-plugin-image-preview.min.css';
---

<AdminLayout title="YSG Studio">
  <!-- Loading Gate: Displayed until client-side session is verified -->
  <div id="admin-gate" class="grid min-h-screen place-items-center bg-brand-maroon-dark px-6 font-mono text-xs text-brand-cream/80">
    <div class="flex items-center gap-3 rounded-xl border border-white/15 bg-brand-maroon px-5 py-3.5 shadow-2xl">
      <div class="size-3.5 animate-spin rounded-full border-2 border-brand-gold border-t-transparent"></div>
      <span class="tracking-wider uppercase">Initializing studio session…</span>
    </div>
  </div>

  <!-- Authenticated Studio Shell (YSG Deep Maroon Frame + Inset Warm Surface) -->
  <div id="admin-content" class="hidden min-h-screen bg-brand-maroon-dark text-brand-ink lg:grid lg:grid-cols-[15.5rem_minmax(0,1fr)] lg:p-2.5 lg:gap-2.5">
    <AdminSidebar />

    <!-- INSET STUDIO VIEWPORT -->
    <div class="flex min-w-0 flex-1 flex-col bg-brand-surface lg:rounded-xl lg:border lg:border-white/15 lg:shadow-2xl overflow-hidden">
      <AdminTopbar />

      <!-- Main Workspace Canvas -->
      <main class="flex-1 p-5 lg:p-7 max-w-[1440px] w-full mx-auto">
        <OverviewPanel />
        <HighlightsPanel />
        <AnnouncementsPanel />
        <StandbyPanels />
      </main>
    </div>
  </div>

  <CommandPaletteModal />
</AdminLayout>

<script>
  import { supabase } from '../../db/supabase';
  import { adminState, fetchStats, getStoredSession, STORAGE_KEY } from '../../scripts/admin/store';
  import { initNavigation } from '../../scripts/admin/navigation';
  import { initOverviewListeners } from '../../scripts/admin/overview';
  import { fetchAlbums, initAlbumsListeners } from '../../scripts/admin/albums';
  import { initPhotosDrawerListeners } from '../../scripts/admin/photosDrawer';
  import { fetchAnnouncements, initAnnouncementsListeners } from '../../scripts/admin/announcements';
  import { initCommandPaletteAndShortcuts } from '../../scripts/admin/commandPalette';

  function boot() {
    const rootPath = window.location.pathname.replace(/\/dashboard\/?$/, '');
    const admin = getStoredSession();
    if (!admin) {
      window.location.replace(`${rootPath}/login/`);
      return;
    }

    const usernameEl = document.getElementById('admin-username');
    const roleEl = document.getElementById('admin-role');
    const avatarEl = document.getElementById('admin-avatar');

    if (usernameEl) usernameEl.textContent = admin.admin_username;
    if (roleEl) roleEl.textContent = admin.role;
    if (avatarEl) avatarEl.textContent = admin.admin_username.charAt(0).toUpperCase();

    document.getElementById('admin-gate')?.remove();
    document.getElementById('admin-content')?.classList.remove('hidden');

    adminState.onTabChange = (targetName) => {
      if (targetName === 'highlights') {
        fetchAlbums();
      } else if (targetName === 'announcements') {
        fetchAnnouncements();
      }
    };

    initNavigation();
    initOverviewListeners();
    initAlbumsListeners();
    initPhotosDrawerListeners();
    initAnnouncementsListeners();
    initCommandPaletteAndShortcuts();

    document.getElementById('sign-out')?.addEventListener('click', async () => {
      sessionStorage.removeItem(STORAGE_KEY);
      if (admin?.admin_id) {
        try {
          await supabase.rpc('record_admin_logout', { p_admin_id: admin.admin_id });
        } catch {
          // Ignore
        }
      }
      window.location.replace(`${rootPath}/login/`);
    });

    fetchStats();
    fetchAlbums(true);
    fetchAnnouncements(true);
  }

  boot();
</script>
