---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Footer from '../../../components/Footer.astro';
import { supabase, type NewsRow } from '../../../db/supabase';
import { resolveAssetImage } from '../../../utils/imageHelper';

// Eagerly index news cover images from src/assets/news/
const localNewsImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../../assets/news/*.{jpeg,jpg,png,webp,avif}',
  { eager: true }
);

// Static paths for all news articles queried strictly from Supabase
export async function getStaticPaths() {
  let articles: NewsRow[] = [];

  try {
    const { data, error } = await supabase.from('news').select('*');
    if (data && !error) {
      articles = data as NewsRow[];
    }
  } catch {
    // offline
  }

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: NewsRow;
}

const { article } = Astro.props;
const title = article.title_en || article.title_bm;
const content = article.content_en || article.content_bm;
const dateStr = article.published_at
  ? new Date(article.published_at).toLocaleDateString('en-MY', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';

// Pre-resolve news cover image
const coverImg = resolveAssetImage(article.cover_image_url, localNewsImages);
---

<Base title={`${title} - Yayasan Sabah Group`} description={article.excerpt_en || title}>
  <main class="min-h-screen py-12 sm:py-16">
    <article class="mx-auto max-w-4xl px-6 lg:px-8">
      {/* Breadcrumb & Back */}
      <div class="mb-8 flex items-center justify-between">
        <a href="/#news" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-maroon hover:text-brand-gold">
          ← Back to News & Events
        </a>
        <span class="inline-flex rounded-full bg-brand-cream px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-maroon">
          {article.category || 'News'}
        </span>
      </div>

      {/* Title */}
      <h1 class="text-3xl font-bold tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
        {title}
      </h1>

      {/* Meta */}
      {dateStr && (
        <div class="mt-4 flex items-center gap-4 text-sm text-brand-muted border-b border-brand-border/60 pb-6">
          <time datetime={article.published_at}>{dateStr}</time>
          <span>•</span>
          <span>Yayasan Sabah Group Corporate Communications</span>
        </div>
      )}

      {/* Hero Cover Image */}
      {coverImg.metadata ? (
        <div class="mt-8 overflow-hidden rounded-2xl border border-brand-border bg-white shadow-md">
          <Image
            src={coverImg.metadata}
            alt={title}
            width={1200}
            height={675}
            class="h-auto w-full object-cover"
          />
        </div>
      ) : coverImg.src ? (
        <div class="mt-8 overflow-hidden rounded-2xl border border-brand-border bg-white shadow-md">
          <img
            src={coverImg.src}
            alt={title}
            class="h-auto w-full object-cover"
          />
        </div>
      ) : null}

      {/* Article Body */}
      <div class="mt-10 prose prose-lg max-w-none text-slate-800 leading-relaxed">
        <p class="text-lg font-medium leading-8 text-slate-700">
          {article.excerpt_en}
        </p>
        <div class="mt-6 space-y-6 text-base leading-7">
          {content ? (
            content.split('\n\n').map((paragraph) => (
              <p>{paragraph}</p>
            ))
          ) : (
            <p>Full article details will be published shortly.</p>
          )}
        </div>
      </div>

      {/* Bottom Back Button */}
      <div class="mt-12 border-t border-brand-border/60 pt-8">
        <a href="/#news" class="inline-flex items-center gap-2 rounded-xl bg-brand-cream/80 px-5 py-2.5 text-sm font-semibold text-brand-maroon hover:bg-brand-gold hover:text-white transition">
          ← Back to All News
        </a>
      </div>
    </article>
  </main>
  <Footer />
</Base>
