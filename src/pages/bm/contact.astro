---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import FeedbackForm from '../../components/FeedbackForm.astro';
---

<Base
  title="Hubungi Kami | Kumpulan Yayasan Sabah"
  description="Hubungi Kumpulan Yayasan Sabah. Pertanyaan mengenai penajaan pendidikan, perkhidmatan awam, program, dan kemudahan."
>
  <main id="main" class="min-h-screen py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      
      {/* Header */}
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-gold">
          Saluran Bantuan
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-brand-maroon sm:text-4xl">
          Hubungi Kami & Saluran Bantuan
        </h1>
        <p class="mt-3 text-base leading-7 text-brand-muted">
          Kami bersedia membantu anda dengan pertanyaan mengenai penajaan pendidikan, aktiviti korporat, dan program komuniti.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-12">
        {/* Left column: Contact Info */}
        <div class="lg:col-span-5 space-y-6">
          <div class="rounded-2xl border border-brand-border bg-white p-6 sm:p-8 shadow-sm">
            <h2 class="text-lg font-bold text-brand-maroon">Ibu Pejabat</h2>
            <div class="mt-4 space-y-4 text-sm text-brand-ink">
              <div class="flex items-start gap-3">
                <svg class="size-5 shrink-0 text-brand-gold mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <div>
                  <p class="font-semibold text-brand-ink">Menara Tun Mustapha</p>
                  <p class="text-brand-muted">Teluk Likas, Peti Surat 11201,<br />88813 Kota Kinabalu, Sabah, Malaysia.</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg class="size-5 shrink-0 text-brand-gold mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <div>
                  <p class="font-semibold text-brand-ink">Telefon</p>
                  <p class="text-brand-muted">+(60) 88-326300 (Pertanyaan Am)</p>
                  <p class="text-brand-muted">+(60) 88-238178 / 88-213227</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg class="size-5 shrink-0 text-brand-gold mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <div>
                  <p class="font-semibold text-brand-ink">E-mel</p>
                  <p class="text-brand-muted">ysinfo@ysnet.org.my</p>
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-brand-gold/30 bg-brand-cream/30 p-6">
            <h3 class="font-bold text-brand-maroon">Waktu Urusan</h3>
            <p class="mt-2 text-sm text-brand-muted leading-relaxed">
              Isnin – Khamis: 8:00 Pagi – 5:00 Petang<br />
              Jumaat: 8:00 Pagi – 11:30 Pagi, 2:00 Petang – 5:00 Petang<br />
              Tutup pada Hujung Minggu & Cuti Umum
            </p>
          </div>
        </div>

        {/* Right column: Interactive Feedback Form */}
        <div class="lg:col-span-7">
          <FeedbackForm locale="bm" />
        </div>
      </div>

    </div>
  </main>
  <Footer locale="bm" />
</Base>
