---
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('bm');
---

<Base title={t('site.name')} description="Portal rasmi Kumpulan Yayasan Sabah">
  <main id="main" class="mx-auto max-w-5xl px-6 py-20">
    <div class="rounded-xl border border-brand-border bg-white p-10 shadow-sm">
      <span class="inline-block rounded-full bg-brand-cream px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-maroon">
        Pembangunan Semula Portal Rasmi
      </span>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-brand-maroon sm:text-5xl">
        {t('site.name')}
      </h1>
      <p class="mt-4 text-lg text-brand-muted">
        {t('site.tagline')}
      </p>
      <div class="mt-8 flex items-center gap-4 border-t border-brand-border pt-6">
        <a
          href="/bm/about/"
          class="inline-flex items-center justify-center rounded-md bg-brand-maroon px-5 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-brand-maroon-dark"
        >
          Ketahui Tentang Kami
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-md border border-brand-border bg-white px-5 py-2.5 text-sm font-semibold text-brand-ink transition-colors hover:bg-stone-50"
        >
          Switch to {t('lang.toggle')}
        </a>
      </div>
    </div>
  </main>
</Base>
