---
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/ui';

import Hero from '../../components/home/Hero.astro';
import QuickAccess from '../../components/home/QuickAccess.astro';
import Announcements from '../../components/home/Announcements.astro';
import LatestNews from '../../components/home/LatestNews.astro';
import DiscoverYSG from '../../components/home/DiscoverYSG.astro';
import HelpContact from '../../components/home/HelpContact.astro';
import Footer from '../../components/Footer.astro';

const t = useTranslations('bm');
---

<Base title={t('site.name')} description="Portal rasmi Kumpulan Yayasan Sabah - Pendidikan, perkhidmatan awam, dan pembangunan sosioekonomi di Sabah.">
  <main id="main">
    <Hero locale="bm" />
    <QuickAccess locale="bm" />
    <Announcements locale="bm" />
    <LatestNews locale="bm" />
    <DiscoverYSG locale="bm" />
    <HelpContact locale="bm" />
  </main>
  <Footer locale="bm" />
</Base>
